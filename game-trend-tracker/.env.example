# Copy this file to .env and fill in your keys.
# With no keys set, the app runs in DEMO MODE with realistic sample data.

# Twitch — create an app at https://dev.twitch.tv/console/apps (free)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 — enable at https://console.cloud.google.com/apis/library/youtube.googleapis.com (free tier)
YOUTUBE_API_KEY=

# Server port (default 3000)
PORT=3000
